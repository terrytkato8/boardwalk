# --- Git LFS: platform signing material ---
# Rules only; committing an unencrypted signing key or keystore is a separate
# decision and generally bad. Prefer CI secrets.
*.keystore        filter=lfs diff=lfs merge=lfs -text
*.p12             filter=lfs diff=lfs merge=lfs -text
*.mobileprovision filter=lfs diff=lfs merge=lfs -text
