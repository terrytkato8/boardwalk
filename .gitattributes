# Boardwalk — Unreal Engine, C++ + Blueprints

# Normalize text to LF in the repository
* text=auto eol=lf

# Unreal text formats
*.uproject text eol=lf
*.uplugin  text eol=lf
*.ini      text eol=lf
*.cpp      text eol=lf
*.h        text eol=lf
*.hpp      text eol=lf
*.c        text eol=lf
*.inl      text eol=lf
*.cs       text eol=lf
*.usf      text eol=lf
*.ush      text eol=lf
*.json     text eol=lf
*.md       text eol=lf
*.txt      text eol=lf
*.xml      text eol=lf
*.csv      text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf

# Descriptors, shaders and editor tooling text (UE5)
*.uprojectdirs text eol=lf
*.hlsl         text eol=lf
*.verse        text eol=lf
*.udn          text eol=lf
*.natvis       text eol=lf
*.usda         text eol=lf
*.mtlx         text eol=lf

# Localization sources under Content/Localization/**
*.manifest text eol=lf
*.archive  text eol=lf
*.po       text eol=lf
*.pot      text eol=lf

# Scripts are line-ending sensitive
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.sh  text eol=lf

# --- Git LFS: Unreal binary assets ---
# `lockable` is declared now so file locking can be switched on later without a
# repo-wide .gitattributes change. Enforcement is OFF by default via
# `lfs.setlockablereadonly=false`
*.uasset filter=lfs diff=lfs merge=lfs -text lockable
*.umap   filter=lfs diff=lfs merge=lfs -text lockable
*.upk    filter=lfs diff=lfs merge=lfs -text
*.udk    filter=lfs diff=lfs merge=lfs -text

