# Visual Studio 2015 user specific files
.vs/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
.vsconfig

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Binary Files
Binaries/*
Plugins/**/Binaries/*

# Builds
Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
Saved/*

# Compiled source files for the engine to use
Intermediate/*
Plugins/**/Intermediate/*

# Cache files for the editor to use
DerivedDataCache/*

# --- Boardwalk additions ---

# JetBrains Rider / ReSharper
.idea/
_ReSharper*/
*.DotSettings.user

# VS Code
.vscode/

# OS cruft
.DS_Store
Thumbs.db
desktop.ini

# Crash artifacts
*.stackdump
*.dmp

# Claude Code machine-local settings (shared settings.json stays tracked)
.claude/settings.local.json

# Stray folder git-lfs creates on Windows when a tool runs git with
# core.hooksPath=/dev/null. Harmless, but it shows up as untracked noise.
/dev/

# Third-party libraries that ship with plugins must be COMMITTED, but the
# blanket *.dll/*.lib/*.a/*.so rules above would swallow them. Un-ignore the
# ThirdParty trees so the LFS rules in .gitattributes can take over.
!Source/**/ThirdParty/**
!Plugins/**/Source/**/ThirdParty/**
